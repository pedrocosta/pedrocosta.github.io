---
layout: layouts/home.njk
title: Blog
---
<p class="prompt">ls -la /blog/</p><h1>Blog</h1>
<ul class="post-list">{% for post in collections.posts | reverse %}<li><span class="date">{{ post.date | postDate }}</span> — <a href="{{ post.url }}">{{ post.data.title }}</a><br><span class="meta">{{ post.data.description }}</span></li>{% endfor %}</ul>
